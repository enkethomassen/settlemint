# ─── BitStream Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in your values. Minimum to run: PORT only.
# The wallet analysis works with zero API keys (heuristics-only mode).

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── Mezo Network ──────────────────────────────────────────────────────────────
MEZO_RPC_URL=https://rpc.matsnet.mezo.org
MEZO_CHAIN_ID=31611
MEZO_NETWORK=testnet

# ── Wallet / Executor Keys ────────────────────────────────────────────────────
PRIVATE_KEY=                          # agent wallet private key (never user's key)
EXECUTOR_ADDRESS=
EXECUTOR_PRIVATE_KEY=

# ── Contract Addresses ────────────────────────────────────────────────────────
MUSD_CONTRACT_ADDRESS=
VAULT_CONTRACT_ADDRESS=
BITSTREAM_VAULT_ADDRESS=
PAYMENT_SCHEDULER_ADDRESS=
COLLATERAL_GUARD_ADDRESS=

# ── x402 Protocol ────────────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_DEMO_MODE=true
X402_SKIP_VALIDATION=false
X402_SPENDING_CAPS={}

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# WALLET INTELLIGENCE — ACE-Protocol-style pipeline
# ─────────────────────────────────────────────────────────────────────────────

# EVM: Alchemy (recommended). Free key at https://www.alchemy.com
# Paste the full network URL. Without this, falls back to Etherscan public API.
ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
EVM_NETWORK=ethereum

# Etherscan fallback (optional). Free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# BTC: Esplora (free, no key)
BTC_ESPLORA_BASE=https://mempool.space/api

# Prices: CoinGecko (free, no key for basic use)
COINGECKO_BASE=https://api.coingecko.com/api/v3
# COINGECKO_KEY=    # optional demo key from coingecko.com/en/api

# AI categorization — pick one provider or leave none for heuristics-only MVP:
#
#   none   → zero keys, heuristics only (good for MVP)
#   groq   → FREE. Key from console.groq.com  (fastest free option)
#   gemini → FREE. Key from aistudio.google.com/apikey
#   ollama → local. Run: ollama pull llama3.1  (no key, fully private)
#   openai → paid. NOT required.
#
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
OLLAMA_BASE=http://localhost:11434
AI_CONFIDENCE_THRESHOLD=0.7
WALLET_DB_PATH=./data/wallet-intel.db

# ── Bots (optional) ───────────────────────────────────────────────────────────
# App URL shown in bot messages (deeplink to login/manage)
BITSTREAM_APP_URL=https://bitstream.app

TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Bitstream
NEXT_PUBLIC_MEZO_NETWORK=testnet
NEXT_PUBLIC_MEZO_CHAIN_ID=31611
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_MAINNET_RPC=https://rpc.mezo.org
NEXT_PUBLIC_TESTNET_RPC=https://rpc.matsnet.mezo.org
NEXT_PUBLIC_MAINNET_EXPLORER=https://explorer.mezo.org
NEXT_PUBLIC_TESTNET_EXPLORER=https://explorer.matsnet.mezo.org
