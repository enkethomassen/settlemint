# ─── BitStream Environment Variables ─────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── Mezo Network ──────────────────────────────────────────────────────────────
MEZO_RPC_URL=https://rpc.matsnet.mezo.org
MEZO_CHAIN_ID=31611
MEZO_NETWORK=testnet

# ── Wallet / Executor Keys ────────────────────────────────────────────────────
# NEVER put a user's private key here — only an agent/executor wallet key.
PRIVATE_KEY=
EXECUTOR_ADDRESS=
EXECUTOR_PRIVATE_KEY=

# ── Contract Addresses ────────────────────────────────────────────────────────
MUSD_CONTRACT_ADDRESS=
VAULT_CONTRACT_ADDRESS=
BITSTREAM_VAULT_ADDRESS=
PAYMENT_SCHEDULER_ADDRESS=
COLLATERAL_GUARD_ADDRESS=

# ── x402 Protocol ────────────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_DEMO_MODE=true
X402_SKIP_VALIDATION=false
X402_SPENDING_CAPS={}

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# WALLET INTELLIGENCE (ACE-style pipeline)
# ─────────────────────────────────────────────────────────────────────────────

# ── EVM data source ───────────────────────────────────────────────────────────
# Get a FREE Alchemy API key at https://www.alchemy.com
# Paste the full network URL — example for Ethereum mainnet:
ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE
EVM_NETWORK=ethereum

# Etherscan fallback (used when no ALCHEMY_URL set). Optional — raises rate limit.
# Free key from https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ── BTC data source (free, no key) ────────────────────────────────────────────
BTC_ESPLORA_BASE=https://mempool.space/api
BITCOIN_API_URL=https://blockstream.info/api

# ── USD Prices (free) ─────────────────────────────────────────────────────────
COINGECKO_BASE=https://api.coingecko.com/api/v3
# Optional demo key from https://www.coingecko.com/en/api — removes rate cap.
# COINGECKO_KEY=

# ── AI categorization layer ───────────────────────────────────────────────────
# provider: groq | gemini | ollama | openai | none
#
#  none   → heuristics only. ZERO keys needed. Works great for MVP.
#  groq   → FREE tier, very fast. Key from https://console.groq.com
#           Model: llama-3.3-70b-versatile
#  gemini → FREE tier. Key from https://aistudio.google.com/apikey
#           Model: gemini-2.0-flash
#  ollama → fully local, $0. Run: ollama pull llama3.1
#           Set OLLAMA_BASE=http://localhost:11434
#  openai → paid. NOT required — heuristics handle 80% of categorization.
#
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
OLLAMA_BASE=http://localhost:11434
AI_CONFIDENCE_THRESHOLD=0.7
WALLET_DB_PATH=./data/wallet-intel.db

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Bots and Notifications
# ─────────────────────────────────────────────────────────────────────────────

# App deeplink sent in bot messages
BITSTREAM_APP_URL=https://bitstream.app

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Frontend (Next.js public vars) ────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Bitstream
NEXT_PUBLIC_MEZO_NETWORK=testnet
NEXT_PUBLIC_MEZO_CHAIN_ID=31611
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_MAINNET_RPC=https://rpc.mezo.org
NEXT_PUBLIC_TESTNET_RPC=https://rpc.matsnet.mezo.org
NEXT_PUBLIC_MAINNET_EXPLORER=https://explorer.mezo.org
NEXT_PUBLIC_TESTNET_EXPLORER=https://explorer.matsnet.mezo.org
